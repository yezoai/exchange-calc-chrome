{
  "manifest_version": 3,
  "name": "Exchange Calc Chrome",
  "version": "0.1.0",
  "description": "Convert selected prices into CNY, USD, and RUB from the context menu.",
  "permissions": [
    "contextMenus",
    "notifications",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://open.er-api.com/*",
    "https://api.exchangerate-api.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Exchange Calc Chrome",
    "default_popup": "popup.html"
  }
}
